# ==========================================
# SENTINEL - Criminal Network Analyser .gitignore
# ==========================================

# Dependencies & Package Managers
node_modules/
**/node_modules/
.npm/
.yarn/
package-lock.json.bak

# Python Virtual Environments & Caches
venv/
.venv/
env/
ENV/
__pycache__/
/**/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Next.js & Frontend Build Outputs
.next/
/**/.next/
out/
build/
dist/
*.tsbuildinfo
/**/*.tsbuildinfo

# Environment Variables & Secret Files (DO NOT COMMIT SECRETS)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Runtime Data, Logs & Uploaded Data
uploads/
**/uploads/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Configurations
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
